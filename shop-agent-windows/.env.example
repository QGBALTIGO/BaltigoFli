# Control plane (Railway)
BALTIGO_CONTROL_URL=https://baltigo-live-cloud-production.up.railway.app/api
BALTIGO_NODE_TOKEN=cole-aqui-o-token-de-pareamento
POLL_SECONDS=3

# OBS WebSocket (OBS 28+ includes obs-websocket)
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=troque-esta-senha

# TikTok Shop LIVE Manager
LIVE_MANAGER_URL=https://seller-br.tiktok.com/
# Optional: leave blank to auto-detect Chrome/Edge
BROWSER_PATH=
# Optional: dedicated browser profile so the user login persists on this VM
BROWSER_PROFILE_DIR=C:\BaltigoShop\browser-profile
